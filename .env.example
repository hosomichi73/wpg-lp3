# Copy this file's variable names into Vercel Project Settings -> Environment Variables.
# Do not put real values in this file, and never commit a real .env file.

# Your Resend API key (from https://resend.com/api-keys)
RESEND_API_KEY=

# Where inquiries should be delivered
CONTACT_TO_EMAIL=whitephat7@gmail.com

# Optional. Must be an address on a domain you verified in Resend (Resend dashboard -> Domains).
# If left unset, emails are sent from Resend's shared test address (onboarding@resend.dev),
# which works but is less deliverable/branded than your own domain.
CONTACT_FROM_EMAIL=
